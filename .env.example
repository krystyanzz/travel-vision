# Copie para .env.local e preencha. Nunca versione chaves reais.

# Limite de buscas por minuto na busca ao vivo (hoje só o provedor de simulação)
QUOTA_SEARCH_PER_MINUTE=60

# AirLabs (mapa de rotas) — https://airlabs.co
AIRLABS_API_KEY=
# Teto de consultas por aeroporto (plano gratuito: 1.000 consultas/mês, 50 linhas por consulta)
AIRLABS_MAX_CALLS=30
# Teto diário de consultas (site + robôs) e reserva mínima da cota mensal informada pela AirLabs
AIRLABS_DAILY_CALLS=60
AIRLABS_MONTHLY_RESERVE=50

# ---------- Robôs de coleta (npm run robots) ----------
# Travelpayouts (afiliados Aviasales): token da Data API, em https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=
# Marcador de afiliado, anexado aos links de redirecionamento
TRAVELPAYOUTS_MARKER=
# Frequência por robô, em minutos (mínimo 5). Padrões: preços 360, câmbio 360, malha 10080
# ROBOT_TRAVELPAYOUTS_PRECOS_EVERY_MIN=360
# ROBOT_BCB_PTAX_EVERY_MIN=360
# ROBOT_AIRLABS_MALHA_EVERY_MIN=10080
# Caminho do banco SQLite (padrão: .data/travel-vision.db)
# ROBOTS_DB_PATH=

# ---------- Área administrativa (/admin) ----------
# Sem senha, /admin só abre em desenvolvimento local. Em produção é obrigatória.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Coleta em segundo plano dentro do servidor do site (padrão: ligada). Use 0 se rodar "npm run robots" à parte.
# ROBOTS_IN_SERVER=1

# SerpAPI (Google Flights): chave em https://serpapi.com/manage-api-key
# Só consulta quando alguém busca (sob demanda), por data exata. Plano grátis: 250 consultas/mês.
SERPAPI_API_KEY=
# Teto de consultas por dia (padrão 8 ≈ 250/mês)
SERPAPI_DAILY_CALLS=8
